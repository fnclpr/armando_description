<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========================================================================= -->
    <!-- METODO 2: Macro con valori di default facoltativi (sintassi :=)           -->
    <!-- Se width, height, update_rate o fov non vengono passati, si usano         -->
    <!-- i valori predefiniti (1080p, 30 FPS, FOV 60deg).                          -->
    <!-- ========================================================================= -->
    <xacro:macro name="camera_sensor" 
                 params="prefix 
                         parent_link 
                         topic_name 
                         width:=1920 
                         height:=1080 
                         update_rate:=30 
                         fov:=1.047 
                         *origin">

        <joint name="${prefix}_joint" type="fixed">
            <parent link="${parent_link}"/>
            <child link="${prefix}_link"/>
            <xacro:insert_block name="origin"/>
        </joint>

        <link name="${prefix}_link">
            <visual>
                <geometry>
                    <box size="0.01 0.03 0.03"/>
                </geometry>
                <material name="red"/>
            </visual>
            <!--<collision>
                <geometry>
                    <box size="0.01 0.03 0.03"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.05"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
            </inertial> -->
        </link>

        <joint name="${prefix}_optical_joint" type="fixed">
            <parent link="${prefix}_link"/>
            <child link="${prefix}_optical_frame"/>
            <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
        </joint>

        <link name="${prefix}_optical_frame"/>

        <gazebo reference="${prefix}_link">
            <sensor name="${prefix}" type="camera">
                <camera>
                    <horizontal_fov>${fov}</horizontal_fov>
                    <image>
                        <width>${width}</width>
                        <height>${height}</height>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>5.0</far>
                    </clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>${update_rate}</update_rate> 
                <visualize>true</visualize> 
                <topic>${topic_name}</topic>
                <gz_frame_id>${prefix}_optical_frame</gz_frame_id> 
            </sensor>
        </gazebo>

    </xacro:macro>

</robot>